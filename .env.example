# 以下均为可选配置，留空则使用默认值

# 本地官方 MCP 启动命令（默认 npx -y @drawio/mcp；可改为全局安装后的 drawio-mcp）
DRAWIO_MCP_CMD=

# 托管官方 MCP 地址（默认 https://mcp.draw.io/mcp；也可指向自建 jgraph/drawio-mcp Docker）
DRAWIO_MCP_URL=

# 自建 draw.io 编辑器地址（默认 https://app.diagrams.net/），内网环境填写
DRAWIO_BASE_URL=

# 布局预览使用的中文字体文件（默认自动查找微软雅黑 / 苹方 / Noto CJK）
PREVIEW_FONT=
PREVIEW_FONT_BOLD=
