# 以下均为可选配置，留空则使用默认值

# 本地官方 MCP 启动命令（默认 npx -y @drawio/mcp；可改为全局安装后的 drawio-mcp）
DRAWIO_MCP_CMD=

# 托管官方 MCP 地址（默认 https://mcp.draw.io/mcp；也可指向自建 jgraph/drawio-mcp Docker）
DRAWIO_MCP_URL=

# 自建 draw.io 编辑器地址（默认 https://app.diagrams.net/），内网环境填写
DRAWIO_BASE_URL=

# 布局预览使用的中文字体文件（默认自动查找微软雅黑 / 苹方 / Noto CJK）
PREVIEW_FONT=
PREVIEW_FONT_BOLD=

# 实际 PNG 导出（CLI 参数优先）；不与 MCP 的 DRAWIO_BASE_URL 混用
# 默认 https://app.diagrams.net/；敏感图纸建议改为获准的自建实例
DRAWIO_RENDER_BASE_URL=
# chrome / msedge / chromium，或浏览器可执行文件绝对路径
DRAWIO_RENDER_BROWSER=
# 可选：按官方 URL 相对路径组织的同版本资源目录（不代表完整离线）
DRAWIO_RENDER_ASSET_DIR=
# 可选：已有 Playwright 模块目录；留空使用 scripts/node_modules/playwright
DRAWIO_PLAYWRIGHT_MODULE=
